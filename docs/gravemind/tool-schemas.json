                "content": {
                  "type": "string"
                }
              },
              "required": [
                "heading",
                "content"
              ]
            },
            "append": {
              "description": "Markdown to append to the end of the document",
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "proposed",
                "verified",
                "archived"
              ]
            },
            "path": {
              "description": "Move/rename the document",
              "type": "string"
            },
            "message": {
              "description": "Summary of the change and its source",
              "type": "string"
            }
          },
          "required": [
            "id",
            "expected_revision"
          ]
        },
        "execution": {
          "taskSupport": "forbidden"
        }
