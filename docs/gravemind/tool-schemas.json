      {
        "name": "gravemind_update",
        "title": "Update knowledge",
        "description": "Modify an existing document. expected_revision must equal the revision from your latest read; stale updates are rejected with a conflict so you can re-read and merge. Provide exactly one of content, body, section or append, and/or metadata fields.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Document id or path"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Revision you read; required for optimistic concurrency"
            },
            "content": {
              "description": "Full replacement Markdown; frontmatter merges with existing",
              "type": "string"
            },
            "body": {
              "description": "Replace the body, keep the frontmatter",
              "type": "string"
            },
            "section": {
              "description": "Replace one section (include its heading line)",
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string"
