      {
        "name": "gravemind_search",
        "title": "Search Gravemind",
        "description": "Search shared knowledge by keywords, a natural-language question, tags, or meaning. Returns snippets with document ids, paths, revisions and relevance scores. Call this before starting unfamiliar work.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Keywords or a natural-language question. Quote \"exact phrases\"."
            },
            "collection": {
              "description": "Restrict to a collection (folder), e.g. projects/example-app",
              "type": "string"
            },
            "tags": {
              "description": "Only documents having all of these tags",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "proposed",
                "verified",
                "archived"
              ]
            },
            "mode": {
              "description": "Defaults to hybrid when semantic search is enabled",
              "type": "string",
              "enum": [
                "keyword",
                "semantic",
                "hybrid"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
