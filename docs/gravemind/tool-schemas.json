              "type": "string"
            },
            "path": {
              "description": "Explicit relative path (overrides collection + title)",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "project": {
              "type": "string"
