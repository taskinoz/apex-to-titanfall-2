# Opt in to project source; never sweep local game data into Git.
/*
!/*.py
!/*.cpp
!/*.nut
!/*.ps1
!/*.md
!/.gitignore
!/.gitattributes
!/docs/
!/art/
!/site/
!/r5-harness/
!/test-harness/
!/northstar/

# Only the current mod sources and the local harness belong in this repository.
/northstar/*
!/northstar/PhaseRunner/
!/northstar/ArenaComposite/
!/northstar/MapTest.Harness/

# Owned runtime state, logs, downloads, releases and game assets stay local.
**/output/
**/logs/
**/downloads/
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/node_modules/
**/session.json
**/.env
**/.env.*
*.log
*.exe
*.dll
*.pdb
*.dmp
*.bsp
*.stbsp
*.rpak
*.starpak
*.vpk
*.mdl
*.rmdl
*.vg
*.phy
*.dds
*.vtf
*.vmt
*.obj
*.smd
*.qc
*.bin
*.npz
*.npy
*.zip
*.7z
*.tga
*.tmp
*.packaging

# The portable site keeps its native screenshot archives.
!/site/dist/
!/site/dist/captures/
