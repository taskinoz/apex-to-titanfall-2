untyped

global function PhaseRunnerPreview_Init

void function PhaseRunnerPreview_Init()
{
	if ( GetMapName() != "mp_phase_runner" )
		return
	ClassicMP_SetCustomIntro( ClassicMP_DefaultNoIntro_Setup, ClassicMP_DefaultNoIntro_GetLength() )
	ClassicMP_ForceDisableEpilogue( true )
	AddCallback_OnClientConnected( PhaseRunnerPreview_AssignTeam )
	AddClientCommandCallback( "phase_runner_where", PhaseRunnerPreview_Position )
	PhaseRunnerModes_Init()
	if ( GetConVarBool( "phase_runner_local_test" ) )
	{
		SetConVarBool( "sp_not_focus_pause", false )
		SetConVarBool( "ns_report_server_to_masterserver", false )
		SetConVarBool( "ns_report_sp_server_to_masterserver", false )
		if ( GetConVarString( "ip" ) == "127.0.0.1" )
			SetConVarBool( "ns_auth_allow_insecure", true )
		printl( "Phase Runner local test: server reporting disabled after startup config." )
		thread PhaseRunnerPreview_TestStatus()
		PhaseRunner_CatwalkChecks()
		PhaseRunner_CenterTruckChecks()
		PhaseRunner_ArtSupportChecks()
		PhaseRunner_TreeChecks()
