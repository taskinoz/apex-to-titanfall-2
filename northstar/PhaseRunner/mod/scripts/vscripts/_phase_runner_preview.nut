}

void function PhaseRunnerPreview_AssignTeam( entity player )
{
	if ( !IsFFAGame() && !IsPrivateMatchSpectator( player ) && player.GetTeam() != TEAM_IMC && player.GetTeam() != TEAM_MILITIA )
		SetTeam( player, GetPlayerArrayOfTeam( TEAM_IMC ).len() <= GetPlayerArrayOfTeam( TEAM_MILITIA ).len() ? TEAM_IMC : TEAM_MILITIA )
	printl( "Phase Runner connected player team=" + player.GetTeam() )
}

bool function PhaseRunnerPreview_Position( entity player, array<string> args )
{
	if ( !IsValid( player ) )
		return true
	vector pos = player.GetOrigin()
	string message = format( "Phase Runner position: %.1f %.1f %.1f", pos.x, pos.y, pos.z )
	printl( message )
	SendHudMessage( player, message, -1, 0.35, 255, 255, 255, 255, 0.1, 12.0, 0.1 )
	return true
}

void function PhaseRunnerPreview_TestStatus()
{
	for ( int i = 0; i < 24; i++ )
	{
		wait 5.0
		printl( "Phase Runner test state=" + GetGameState() + " time=" + Time() )
		foreach ( entity player in GetPlayerArray() )
			printl( "Phase Runner test player: team=" + player.GetTeam() + " alive=" + IsAlive( player ) + " origin=" + player.GetOrigin() )
	}
}

